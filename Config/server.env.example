# AstralParty server configuration.
# Copy this file to Config/server.env and adjust the values before starting.
# Every variable is optional unless stated otherwise; sensible defaults are used
# when a line is removed.

# --- Network -----------------------------------------------------------------

# TCP address the game client connects to (game protocol, port 8800).
LISTEN_ADDR=:8800

# HTTP address for the dispatch/bootstrap listener (port 7878). This is the
# endpoint the client hits for hotaddressExtend/hotaddressServer JSON.
WEB_CONFIG_ADDR=127.0.0.1:7878

# Host:port advertised to clients inside the bootstrap response. Must be
# reachable from the client device; set it to the server's LAN or public IP.
# May also be changed at runtime through the admin console.
GAME_SERVER_URL=0.0.0.0:8800

# --- Storage -----------------------------------------------------------------

# SQLite database file. Use ":memory:" for a throwaway test server.
DB_PATH=Server/data/server.db

# Directory for on-disk packet captures (only written when capture is enabled).
CAPTURE_DIR=Server/data/captures

# --- Game resources ----------------------------------------------------------

# Directory holding the extracted config-table JSON dumps (Item_infos.json etc).
RESOURCE_DIR=Resources/Data

# Bootstrap response templates. The example files pin metadata to the shipped
# 3.2.0 snapshot and are enough for a private LAN setup.
HOTADDRESS_SERVER_JSON=Resources/bootstrap/hotaddressServer.example.json
HOTADDRESS_EXTEND_JSON=Resources/bootstrap/hotaddressExtend.example.json

# --- Hot update --------------------------------------------------------------

# Optional: extracted v3.2.0 Addressables cache root containing
# catalog_3.2.0.hash, catalog_3.2.0.json and AssetBundles/<group>/<id>/__data.
# When set, the dispatch listener serves catalog-listed local bundles from this
# cache.
HOTUPDATE_ROOT=

# Public URL returned as the hot-update sourceUrl in hotaddressExtend. Point it
# at this server's reachable dispatch URL when HOTUPDATE_ROOT is set.
HOT_UPDATE_URL=https://0.0.0.0

# Notes on the bootstrap chain:
# - The tracked example JSON files pin metadata to the supplied 3.2.0 snapshot.
# - The hotaddressServer placeholder serverUrl is replaced only after
#   GAME_SERVER_URL is valid.
# - If HOTUPDATE_ROOT/HOT_UPDATE_URL are empty, hot-update files still download
#   from the sourceUrl inside the selected bootstrap JSON (official CDN by
#   default), so the client can boot before the local CDN is populated.
# - For proxying a live upstream response, unset both paths and configure
#   UPSTREAM_ROUTE from a real client bootstrap request before switching modes.

# --- Gameplay ----------------------------------------------------------------

# Accept unauthenticated dev logins (AuthType_Dev). NEVER enable on a public
# deployment; intended for local testing only.
ALLOW_DEV_LOGIN=false

# Enable the in-game test RPC echo endpoint. Testing only.
ALLOW_TEST_RPC=false

# Let server-side bots fill empty room slots so single players can start games.
BOT_AUTO_FILL=true

# Log redacted HTTP/RPC request and response payloads for every protocol
# message. Useful while debugging; set false to reduce log volume.
PROTOCOL_TRACE=true

# --- Accounts and authentication ----------------------------------------------

# Enable e-mail based account registration and login. Requires the SMTP block
# below and a reachable HTTPS endpoint. While false, the phone-number login
# endpoint intentionally rejects login instead of faking success.
AUTH_EMAIL_ENABLED=false

# HMAC secret for login codes. Generate one with: openssl rand -hex 32
AUTH_CODE_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Hours a login session stays valid. 720 = 30 days.
AUTH_SESSION_HOURS=720

# Set true when a trusted reverse proxy (nginx, Caddy) terminates TLS in front
# of this process and forwards X-Forwarded-Proto. Direct HTTP auth traffic is
# then rejected.
AUTH_BEHIND_TLS_PROXY=true

# Only accept X-Forwarded-Proto: https from these reverse-proxy peers.
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Emergency switch to accept plain HTTP auth traffic. Keep false except for
# isolated local development or a trusted private LAN.
AUTH_ALLOW_HTTP=false

# Optional override for another client version; the supplied v3.2.0 APK
# manifest value is the default.
BNSDK_PAY_SIGN=

# --- SMTP (only required when AUTH_EMAIL_ENABLED=true) -----------------------

# SMTP server used to deliver login codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# SMTP security mode: "starttls" (default), "ssl", or "plain".
SMTP_TLS_MODE=starttls

# Account and sender address. Replace the example placeholders.
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=game@example.com
